# Required for live API calls. Get a pay-as-you-go key at:
# https://platform.minimax.io  (Account > API Keys > Create new secret key)
MINIMAX_API_KEY=your-minimax-api-key

# Optional. Default: https://api.minimax.io
MINIMAX_API_HOST=https://api.minimax.io

# Optional. Directory for downloaded mp4 files.
# Default: ./minimax-h3-output in the process working directory
MINIMAX_H3_OUTPUT_DIR=./minimax-h3-output

# Optional. Path to a JSON file {"api_key":"..."} or a one-line key file.
# MINIMAX_API_KEY_FILE=

# Optional. Directory of {id}/minimax.json files used as a fallback key store.
# MINIMAX_CONNECTOR_SECRETS_ROOT=
# MINIMAX_AGENT_ID=

# Set to 1 in tests. Refuses live HTTP unless an httpx client is injected.
# MINIMAX_H3_TEST_MODE=1
